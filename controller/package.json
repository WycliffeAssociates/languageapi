{
  "name": "gql-db-controller-v2b",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "echo \"No tests yet...\"",
    "generate": "pnpm exec drizzle-kit generate",
    "generate-custom-migration": "drizzle-kit generate --custom",
    "preview": "pnpm run clean && pnpm run build && pnpm run start",
    "getMock": "pnpm exec ts-node ./src/db/utils/getMocks.ts",
    "getOpenApi": "pnpm exec ts-node ./src/docs/openApi.ts",
    "visualize": "pnpm drizzle-kit studio --verbose",
    "migrate": "pnpm exec ts-node ./src/migrate.ts",
    "drop-migrations": "drizzle-kit drop"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.2.0",
    "@azure/functions": "^4.10.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "api-spec-converter": "^2.12.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.7",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.8",
    "pg": "^8.16.3",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.1"
}
